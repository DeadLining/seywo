#!/bin/sh
# Compatibility shortcut for previous local registrations.
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = --mcp ]; then
  exec uv run --no-config --no-project --python '>=3.11' --with mcp==1.28.1 python -B "$HERE/bin/seywo-launch.py" "$@"
fi
exec uv run --offline --no-config --no-project --python '>=3.11' --with mcp==1.28.1 python -B "$HERE/bin/seywo-launch.py" --hook "$@"
