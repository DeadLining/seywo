#!/bin/sh
# Resolve a usable Python/MCP runtime; never install into the user's Python.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PLUGIN_ROOT=$HERE
export PLUGIN_ROOT
if [ "${1:-}" = "--mcp" ]; then
  shift
  MODE=mcp
else
  MODE=kernel
fi
PYTHON=${SEYWO_PYTHON:-python3}
if [ "$MODE" = kernel ]; then
  if "$PYTHON" -c 'import sys; assert sys.version_info >= (3,11)' >/dev/null 2>&1; then
    PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$PYTHON" -B -m seywo.hook "$@"
  fi
else
  if "$PYTHON" -c 'import sys,mcp; from importlib.metadata import version; assert sys.version_info >= (3,11); assert (1,28,1) <= tuple(map(int,version("mcp").split("."))) < (2,0,0)' >/dev/null 2>&1; then
    exec "$PYTHON" -B "$HERE/bin/seywo-plugin" "$@"
  fi
fi
# uv supplies Python and SDK in its own cache when the system runtime is absent.
UV=${SEYWO_UV:-uv}
if ! command -v "$UV" >/dev/null 2>&1 && [ -x "$HOME/.local/bin/uv" ]; then UV="$HOME/.local/bin/uv"; fi
if command -v "$UV" >/dev/null 2>&1; then
  if [ "$MODE" = mcp ]; then
    exec "$UV" run --no-project --python '>=3.11' --with 'mcp==1.28.1' -- python -B "$HERE/bin/seywo-plugin" "$@"
  fi
  PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}" PYTHONDONTWRITEBYTECODE=1 exec "$UV" run --no-project --python '>=3.11' -- python -B -m seywo.hook "$@"
fi
# Python 3.11+ but no SDK/uv: provision a private, reusable plugin data venv.
if [ "$MODE" = mcp ] && "$PYTHON" -c 'import sys; assert sys.version_info >= (3,11)' >/dev/null 2>&1; then
  DATA=${PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/seywo}
  exec "$PYTHON" -B "$HERE/bin/seywo-bootstrap" "$DATA" "$@"
fi
printf '%s\n' 'Seywo needs Python 3.11+ or uv. Install uv to provision its private runtime automatically.' >&2
exit 1
