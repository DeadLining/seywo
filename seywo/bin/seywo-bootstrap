#!/usr/bin/env python3
"""First-run SDK provisioning in plugin data, with a process lock."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import venv

root = Path(__file__).resolve().parent.parent
state = Path(sys.argv[1]).expanduser().resolve()
state.mkdir(mode=0o700, parents=True, exist_ok=True)
with (state / 'runtime.lock').open('a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    runtime = state / 'python-runtime'
    python = runtime / 'bin/python3'
    if not python.exists():
        venv.EnvBuilder(with_pip=True).create(runtime)
    ready = subprocess.run([str(python), '-c', 'import mcp; from importlib.metadata import version; assert version("mcp") == "1.28.1"'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not ready:
        install = subprocess.run([str(python), '-m', 'pip', 'install', '--disable-pip-version-check', 'mcp==1.28.1'],
                                 stdout=sys.stderr, stderr=sys.stderr, timeout=180)
        if install.returncode:
            raise SystemExit('Seywo could not provision its private MCP runtime. Check network access and reconnect.')
os.execv(str(python), [str(python), '-B', str(root / 'bin/seywo-plugin'), *sys.argv[2:]])
