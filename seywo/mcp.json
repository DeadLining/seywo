{
  "mcpServers": {
    "seywo": {
      "command": "uv",
      "args": [
        "run",
        "--no-config",
        "--no-project",
        "--python",
        ">=3.11",
        "--with",
        "mcp==1.28.1",
        "python",
        "-B",
        "./bin/seywo-launch.py",
        "--mcp"
      ],
      "cwd": ".",
      "startup_timeout_sec": 240
    }
  }
}
